rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leads: consultation inquiries submitted from site contact forms
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Client documents repository
    match /client_documents/{docId} {
      allow read, write: if true;
    }

    // Dynamic website configuration and CMS sections
    match /service_groups/{groupId} {
      allow read, write: if true;
    }
    match /faqs/{faqId} {
      allow read, write: if true;
    }
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }
    match /site_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
